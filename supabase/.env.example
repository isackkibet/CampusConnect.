# Local function secrets for `supabase functions serve --env-file supabase/.env`.
# In production use `supabase secrets set ...`. Never commit a filled copy.

# Provided automatically in the hosted environment, but useful locally.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq assistant
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# M-PESA Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=
# Must include ?secret=<MPESA_CALLBACK_SECRET>
MPESA_CALLBACK_URL=
