# Leave both blank to run the dashboard in clearly-labelled demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for moderation actions. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional public link back to the student app / docs.
NEXT_PUBLIC_APP_DOWNLOAD_URL=
